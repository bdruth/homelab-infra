#!/usr/bin/env bash
# Open WebUI watchdog. Generated by the nvidia-gpu Ansible role.
#
# Runs from open-webui-watchdog.timer. Probes the local /ready endpoint. If it
# stays unhealthy for DOWN_GRACE_SEC (any unit state, including a restart loop),
# it removes the container and restarts the unit, and sends one Pushover alert.
# It sends a second alert when the service answers again.
#
# Cold starts are covered by the grace period: a healthy boot (image pull,
# Playwright/Chromium install) is ready well inside 10 minutes.

set -u
PORT="{{ open_webui_port }}"
UNIT="open-webui.service"
CONTAINER="open-webui"
DOWN_GRACE_SEC="{{ open_webui_watchdog_down_grace_sec | default(600) }}"
REMIND_SEC="{{ open_webui_watchdog_remind_sec | default(3600) }}"
STATE_DIR="${STATE_DIRECTORY:-/var/lib/open-webui-watchdog}"
ENV_FILE="/etc/open-webui/watchdog.env"
TAG="open-webui-watchdog"
HOST="$(hostname -s)"

mkdir -p "$STATE_DIR"
FIRST_FAIL="$STATE_DIR/first_fail"   # epoch of the first failed probe in this outage
LAST_ACTION="$STATE_DIR/last_action" # epoch of the last restart we triggered
LAST_ALERT="$STATE_DIR/last_alert"   # epoch of the last "down" alert
NOW="$(date +%s)"

log() { logger -t "$TAG" -- "$*"; echo "$TAG: $*"; }

# Pushover is optional: with no token or user the watchdog only logs.
PUSHOVER_TOKEN=""
PUSHOVER_USER=""
# shellcheck disable=SC1090
[ -r "$ENV_FILE" ] && . "$ENV_FILE"

notify() {
    local title="$1" message="$2" priority="${3:-0}"
    if [ -z "$PUSHOVER_TOKEN" ] || [ -z "$PUSHOVER_USER" ]; then
        return 0
    fi
    curl -fsS -m 15 \
        --form-string "token=${PUSHOVER_TOKEN}" \
        --form-string "user=${PUSHOVER_USER}" \
        --form-string "title=${title}" \
        --form-string "message=${message}" \
        --form-string "priority=${priority}" \
        https://api.pushover.net/1/messages.json >/dev/null 2>&1 \
        || log "pushover notification failed"
}

fmt_duration() {
    local s="$1"
    printf '%dh%02dm' $((s / 3600)) $(((s % 3600) / 60))
}

if curl -fsS -m 10 "http://127.0.0.1:${PORT}/ready" >/dev/null 2>&1; then
    if [ -s "$FIRST_FAIL" ]; then
        since="$(cat "$FIRST_FAIL")"
        # Only announce recovery if we raised the alarm for this outage.
        if [ -s "$LAST_ALERT" ]; then
            notify "Open WebUI recovered" "${HOST}: Open WebUI answers again after $(fmt_duration $((NOW - since)))."
        fi
        log "recovered after $((NOW - since))s"
    fi
    rm -f "$FIRST_FAIL" "$LAST_ACTION" "$LAST_ALERT"
    exit 0
fi

# State survives the nightly power-off. An outage recorded before this boot says
# nothing about the current start, so discard it instead of treating a normal
# cold start as hours of downtime.
boot_epoch=$((NOW - $(cut -d. -f1 /proc/uptime)))
if [ -s "$FIRST_FAIL" ] && [ "$(cat "$FIRST_FAIL")" -lt "$boot_epoch" ]; then
    log "discarding outage state recorded before this boot"
    rm -f "$FIRST_FAIL" "$LAST_ACTION" "$LAST_ALERT"
fi

[ -s "$FIRST_FAIL" ] || echo "$NOW" >"$FIRST_FAIL"
since="$(cat "$FIRST_FAIL")"
down_for=$((NOW - since))

if [ "$down_for" -lt "$DOWN_GRACE_SEC" ]; then
    log "/ready failing for ${down_for}s, within the ${DOWN_GRACE_SEC}s grace period"
    exit 0
fi

last_action=0
[ -s "$LAST_ACTION" ] && last_action="$(cat "$LAST_ACTION")"
if [ $((NOW - last_action)) -lt "$DOWN_GRACE_SEC" ]; then
    log "/ready failing for ${down_for}s; restarted recently, waiting"
    exit 0
fi

log "/ready failing for ${down_for}s; removing container and restarting ${UNIT}"
echo "$NOW" >"$LAST_ACTION"
# A container stuck in "stopping" survives `systemctl restart`; force it out.
docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
systemctl restart --no-block "$UNIT"

last_alert=0
[ -s "$LAST_ALERT" ] && last_alert="$(cat "$LAST_ALERT")"
if [ $((NOW - last_alert)) -ge "$REMIND_SEC" ]; then
    echo "$NOW" >"$LAST_ALERT"
    notify "Open WebUI is down" "${HOST}: /ready has failed for $(fmt_duration "$down_for"). Restarted ${UNIT}." 1
fi
exit 0
