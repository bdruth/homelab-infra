[Unit]
Description=Open WebUI
# network-online: the image pull and function requirement installs (e.g.
# google-genai for the Gemini pipe) need DNS, which isn't up at network.target.
After=network-online.target podman.service nvidia-persistenced.service open-terminal.service searxng.service
Wants=network-online.target{{ ' open-terminal.service' if install_open_terminal | default(false) | bool else '' }}{{ ' searxng.service' if install_searxng | default(false) | bool else '' }}
Requires=podman.service

[Service]
Type=simple
Restart=always
RestartSec=10
# The start window covers ExecStartPre (image pull) plus ExecStartPost, which
# waits up to 5 minutes for /ready on a cold start (Playwright/Chromium install).
# The 90s systemd default killed healthy but slow starts; the SIGTERM/SIGKILL
# that followed left the container stuck in "stopping" and wedged every later
# start (homelab-infra-25g).
TimeoutStartSec={{ open_webui_start_timeout_sec | default(600) }}
TimeoutStopSec={{ open_webui_stop_timeout_sec | default(120) }}
WorkingDirectory={{ open_webui_install_dir }}
# At boot nvidia_uvm loads without creating /dev/nvidia-uvm, and the CDI
# injection of nvidia.com/gpu=all fails until it exists.
ExecStartPre=-/usr/bin/nvidia-modprobe -u -c=0
{% if nvidia_install_gpu_drivers | bool %}
# Build the CDI spec for the GPUs that exist right now. nvidia-cdi-refresh runs
# After=multi-user.target, which cannot finish until this unit's start job does,
# so on the first start after boot the only spec on disk was the stale
# /etc/cdi one. It lists the Thunderbolt eGPU's /dev/nvidia1, but the eGPU is
# not attached yet at boot, so podman exited 127 every night. Generating as root
# also creates any device node the spec names. Do not order this unit after
# nvidia-cdi-refresh: that would be an ordering cycle.
ExecStartPre=-/usr/bin/mkdir -p /run/cdi
ExecStartPre=-/usr/bin/nvidia-ctk cdi generate --output=/run/cdi/nvidia.yaml
{% endif %}
# Clear leftovers from a previous run. A container stuck in "stopping" cannot be
# removed without -f, and `docker rm` without it made "name already in use"
# (exit 125) repeat forever.
ExecStartPre=-/usr/bin/docker stop -t 30 open-webui
ExecStartPre=-/usr/bin/docker rm -f open-webui
ExecStartPre=-/usr/bin/docker pull ghcr.io/open-webui/open-webui:{{ open_webui_image_tag }}
ExecStart=/usr/bin/docker run --name open-webui --replace \
  --env-file /etc/open-webui/open-webui.env \
  -v {{ open_webui_install_dir }}/data:/app/backend/data \
  -e OLLAMA_BASE_URL=http://host.containers.internal:11434 \
  -e OLLAMA_API_BASE_URL=http://host.containers.internal:11434/api \
  -e PORT={{ open_webui_port }} \
  -e ENABLE_WEB_SEARCH={{ open_webui_enable_web_search | string | lower }} \
  -e ENABLE_SEARCH_QUERY_GENERATION={{ open_webui_enable_search_query_generation | string | lower }} \
{% if install_searxng | default(false) | bool %}
  -e WEB_SEARCH_ENGINE=searxng \
  -e SEARXNG_QUERY_URL=http://host.containers.internal:{{ searxng_port }}/search \
{% else %}
  -e WEB_SEARCH_ENGINE={{ open_webui_web_search_engine }} \
{% endif %}
  -e WEB_LOADER_ENGINE={{ open_webui_web_loader_engine }} \
  -e ENABLE_OPENAI_API={{ open_webui_enable_openai_api | string | lower }} \
{% set _openai_urls = [open_webui_openai_api_base_url] %}
{% if install_copilot_api | default(false) | bool %}
{%   set _ = _openai_urls.append('http://host.containers.internal:' ~ copilot_api_port ~ '/v1') %}
{% endif %}
  -e OPENAI_API_BASE_URLS={{ _openai_urls | join(';') }} \
  {% if open_webui_enable_authelia | default(false) | bool %}\
  -e WEBUI_URL={{ open_webui_url | default('https://' + ansible_facts["fqdn"]) }} \
  -e ENABLE_OAUTH_SIGNUP=true \
  -e OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true \
  -e OAUTH_CLIENT_ID={{ open_webui_oauth_client_id }} \
  -e OPENID_PROVIDER_URL={{ open_webui_authelia_url }}/.well-known/openid-configuration \
  -e OAUTH_PROVIDER_NAME=Authelia \
  -e OAUTH_SCOPES="openid email profile groups" \
  -e ENABLE_OAUTH_ROLE_MANAGEMENT=true \
  -e OAUTH_ALLOWED_ROLES={{ open_webui_allowed_roles | default('') }} \
  -e OAUTH_ADMIN_ROLES={{ open_webui_admin_roles | default('openwebui-admin') }} \
  -e OAUTH_ROLES_CLAIM=groups \
  {% endif %}\
  {% if install_comfyui | bool %}-e COMFYUI_BASE_URL=http://0.0.0.0:{{ comfyui_port }}/ \
  -e ENABLE_IMAGE_GENERATION={{ open_webui_enable_image_generation | string | lower }} {% endif %} \
  -e ENABLE_PERSISTENT_CONFIG=false \
  -e OAUTH_CODE_CHALLENGE_METHOD=S256 \
  -e ENABLE_API_KEYS={{ open_webui_enable_api_keys | string | lower }} \
  -e DEFAULT_MODEL_METADATA='{{ open_webui_default_model_metadata
    | combine({'terminalId': 'open-terminal'} if install_open_terminal | default(false) | bool else {})
    | to_json }}' \
  -e DEFAULT_MODEL_PARAMS='{{ open_webui_default_model_params | to_json }}' \
  -e DEFAULT_MODELS='{{ open_webui_default_models | default('') }}' \
  -e DEFAULT_PINNED_MODELS='{{ open_webui_default_pinned_models | default([]) | join(',') }}' \
  -e TASK_MODEL_EXTERNAL='{{ open_webui_task_model_external | default('') }}' \
  -e BYPASS_MODEL_ACCESS_CONTROL={{ open_webui_bypass_model_access_control | default(false) | string | lower }} \
  -e ENABLE_SUBAGENTS={{ open_webui_enable_subagents | default(false) | string | lower }} \
  -e ENABLE_TOOL_SEARCH={{ open_webui_enable_tool_search | default(false) | string | lower }} \
  -e ENABLE_TOOL_PERMISSIONS={{ open_webui_enable_tool_permissions | default(false) | string | lower }} \
  -p {{ open_webui_port }}:{{ open_webui_port }} \
  {% if nvidia_install_gpu_drivers | bool %}--device nvidia.com/gpu=all --security-opt=label=disable {% endif %} \
  ghcr.io/open-webui/open-webui:{{ open_webui_image_tag }}

# Re-apply OpenAI connection config (per-connection api_type and model_ids)
# after every container start. ENABLE_PERSISTENT_CONFIG=false means env vars
# seed the DB on every container creation, but OPENAI_API_CONFIGS has no
# env-var equivalent so this hook fills the gap. Script no-ops cleanly when
# token/payload files are absent.
ExecStartPost=/usr/local/bin/open-webui-seed-connections.sh

ExecStop=/usr/bin/docker stop open-webui
# Always leave no container behind, whatever state the stop ended in.
ExecStopPost=-/usr/bin/docker rm -f open-webui

[Install]
WantedBy=multi-user.target
