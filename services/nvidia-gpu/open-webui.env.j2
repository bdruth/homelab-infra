# Secrets for the Open WebUI container, read by `podman run --env-file`.
# Managed by the nvidia-gpu Ansible role; mode 0600, root only. Values are taken
# literally (no quoting, no systemd % or $ expansion), unlike -e on an ExecStart
# line, and they stay out of the unit file and `systemctl status` output.
{% set _openai_keys = [open_webui_openai_api_key] %}
{% if install_copilot_api | default(false) | bool %}
{%   set _ = _openai_keys.append('dummy') %}
{% endif %}
OPENAI_API_KEYS={{ _openai_keys | join(';') }}
WEBUI_SECRET_KEY={{ open_webui_secret_key }}
{% if open_webui_enable_authelia | default(false) | bool %}
OAUTH_CLIENT_SECRET={{ open_webui_oauth_client_secret }}
{% endif %}
{% if install_open_terminal | default(false) | bool %}
TERMINAL_SERVER_CONNECTIONS={{ [{'id': 'open-terminal', 'name': 'Open Terminal', 'url': 'http://host.containers.internal:' ~ open_terminal_port, 'key': open_terminal_api_key, 'auth_type': 'bearer', 'enabled': true}] | to_json }}
{% endif %}
