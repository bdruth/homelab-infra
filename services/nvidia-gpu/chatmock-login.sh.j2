#!/bin/bash
# Stores a ChatGPT login for one seat. Generated by the nvidia-gpu Ansible role.
#
# Usage: sudo chatmock-login <seat>   (seats: {{ chatgpt_proxy_seats | map(attribute='name') | join(', ') }})
#
# It uses ChatGPT's device-code sign-in: it prints a short code and a URL. Open
# the URL in any browser (on any device), sign in as that seat's ChatGPT user,
# and enter the code. Nothing needs to be pasted back here.
set -eu

SEAT="${1:-}"
case "$SEAT" in
{% for seat in chatgpt_proxy_seats %}
    {{ seat.name }}) ;;
{% endfor %}
    *) echo "usage: $0 <{{ chatgpt_proxy_seats | map(attribute='name') | join('|') }}>" >&2; exit 2 ;;
esac

SEAT_DIR="{{ chatgpt_proxy_install_dir }}/seats/${SEAT}"

docker run --rm -it \
    --name "chatmock-login-${SEAT}" \
    -v "${SEAT_DIR}:/data" \
    -e CHATGPT_LOCAL_HOME=/data \
    localhost/chatmock:{{ chatgpt_proxy_image_tag }} login --headless

chmod 600 "${SEAT_DIR}/auth.json"
systemctl restart "chatmock-${SEAT}.service"
echo "chatmock-${SEAT} restarted with the new login"
