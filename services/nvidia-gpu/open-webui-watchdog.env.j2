# Pushover credentials for the Open WebUI watchdog. Managed by Ansible; mode 0600.
# Leave both empty to log only.
PUSHOVER_TOKEN="{{ open_webui_watchdog_pushover_token | default(pushover_token | default('')) }}"
PUSHOVER_USER="{{ open_webui_watchdog_pushover_user | default(pushover_user_id | default('')) }}"
