# Managed by homelab-infra services/agentsview
[Unit]
Description=Push Claude and Codex transcripts to AgentsView every {{ agentsview_upload_interval_minutes }} minutes

[Timer]
OnCalendar=*:0/{{ agentsview_upload_interval_minutes }}
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
